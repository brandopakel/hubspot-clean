# Copy this file to .env and fill in your real token.
#
#   cp .env.example .env
#
# Get a private app token from HubSpot (use a sandbox portal first):
# Settings -> Integrations -> Private Apps -> Create a private app
#
# Scopes:
#   crm.objects.contacts.read    required by every audit
#   crm.objects.contacts.write   required only by `merge --apply`
#
# .env is gitignored - never commit your real token.

HUBSPOT_ACCESS_TOKEN=your-private-app-token-here
